# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to terraform.tfvars and fill in your real values.
# NEVER commit terraform.tfvars to Git.
# ─────────────────────────────────────────────────────────────────────────────

# Cluster
kubeconfig_path = "~/.kube/config"
kube_context    = "docker-desktop"

# Database credentials
db_user     = "CHANGE_ME"
db_password = "CHANGE_ME"
db_name     = "CHANGE_ME"

# JWT
jwt_secret_key = "CHANGE_ME"

# Webhooks
webhook_shared_secret = "CHANGE_ME"

# Optional overrides (defaults are already set in variables.tf)
# app_env              = "production"
# app_debug            = "false"
# api_min_replicas     = 2
# api_max_replicas     = 10
# api_node_port        = 30800
# postgres_storage_size = "5Gi"
